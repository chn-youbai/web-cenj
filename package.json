{
  "name": "web-cenj",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Web-Cenj personal digital hub (Vite MPA + Full-stack TypeScript + Cloudflare Pages Functions)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^16.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
