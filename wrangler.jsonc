{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-cenj",
  "compatibility_date": "2026-09-30",
  "pages_build_output_dir": "dist",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-vocab-db",
      "database_id": "5e691588-a2df-428a-b786-d5f9703c9554"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CLICKS_KV",
      "id": "c45f6c3c1878427799785da4f984e52c"
    }
  ]
}
