# Cloudflare Pages 环境变量配置模板
# 请在 Cloudflare Dashboard -> Workers & Pages -> web-cenj -> Settings -> Environment variables 中配置以下真实值
# 本地 wrangler pages dev 联调时，可复制为 .dev.vars（已加入 .gitignore，切勿提交真实密钥）

# 管理员统一密码（用于视频管理、Clash 与外卖初始默认密码回退）
ADMIN_PASSWORD=

# 网盘订阅与美区 Apple ID 共享账号解锁密码
ACCESS_PASSWORD=

# 家中 PC 守护进程 clash_daemon.pyw 请求头 X-Clash-Daemon-Secret 鉴权密钥
CLASH_DAEMON_SECRET=

# 顶级机场订阅 Token（D1 未存 djjc_config 时生效）
DJJC_TOKEN=

# VPN07 官网登录凭据（可选，D1 未存 vpn07_credentials 时生效）
VPN07_EMAIL=
VPN07_PASSWORD=

# 美区共享 Apple ID 凭据（解锁后由 /api/subscription 动态下发）
APPLE_ID_EMAIL=
APPLE_ID_PASSWORD=

# 视频直传 GitHub Releases Token（配置后上传页支持直接用管理密码免填 Token 上传）
GITHUB_MEDIA_TOKEN=
